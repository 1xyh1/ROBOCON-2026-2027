<?xml version="1.0"?>
<sdf version="1.6">

<world name="field_simplified">

  <!--太阳 平行光-->
  <light name="sun" type="directional">
    <cast_shadows>true</cast_shadows>
    <pose>0 0 10 0 0 0</pose>
    <diffuse>0.8 0.8 0.8 1</diffuse>
    <specular>0.2 0.2 0.2 1</specular>
    <direction>-0.5 0.1 -0.9</direction>
  </light>


  <!--场地地板 11m x 11m 顶面正好在z=0-->
  <model name="field_floor">
    <static>true</static>
    <pose>0 0 -0.05 0 0 0</pose>
    <link name="floor_link">

      <visual name="floor_visual">
        <geometry>
          <box><size>11 11 0.1</size></box>
        </geometry>
        <material>
          <ambient>0.4 0.4 0.4 1</ambient>
          <diffuse>0.4 0.4 0.4 1</diffuse>
        </material>
      </visual>

      <collision name="floor_collision">
        <geometry>
          <box><size>11 11 0.1</size></box>
        </geometry>
      </collision>

    </link>
  </model>


  <!--建造格1 0.5m x 0.5m 绿色标识 只有visual没有collision 机器人可以直接压过-->
  <model name="build_slot_1">
    <static>true</static>
    <pose>0.5 0.5 0.001 0 0 0</pose>
    <link name="slot_link">

      <visual name="slot_visual">
        <geometry>
          <box><size>0.5 0.5 0.002</size></box>
        </geometry>
        <material>
          <ambient>0 0.8 0 1</ambient>
          <diffuse>0 0.8 0 1</diffuse>
        </material>
      </visual>

    </link>
  </model>





  <!--封闭围栏 四面墙 内侧面正好在±5.5 有collision是真实障碍-->
  <model name="field_fence">
    <static>true</static>
    <pose>0 0 0 0 0 0</pose>

    <link name="wall_north_link">
      <pose>0 5.55 0.15 0 0 0</pose>
      <visual name="wall_north_visual">
        <geometry><box><size>11.2 0.1 0.3</size></box></geometry>
        <material>
          <ambient>0.25 0.25 0.25 1</ambient>
          <diffuse>0.25 0.25 0.25 1</diffuse>
        </material>
      </visual>
      <collision name="wall_north_collision">
        <geometry><box><size>11.2 0.1 0.3</size></box></geometry>
      </collision>
    </link>

    <link name="wall_south_link">
      <pose>0 -5.55 0.15 0 0 0</pose>
      <visual name="wall_south_visual">
        <geometry><box><size>11.2 0.1 0.3</size></box></geometry>
        <material>
          <ambient>0.25 0.25 0.25 1</ambient>
          <diffuse>0.25 0.25 0.25 1</diffuse>
        </material>
      </visual>
      <collision name="wall_south_collision">
        <geometry><box><size>11.2 0.1 0.3</size></box></geometry>
      </collision>
    </link>

    <link name="wall_east_link">
      <pose>5.55 0 0.15 0 0 0</pose>
      <visual name="wall_east_visual">
        <geometry><box><size>0.1 11 0.3</size></box></geometry>
        <material>
          <ambient>0.25 0.25 0.25 1</ambient>
          <diffuse>0.25 0.25 0.25 1</diffuse>
        </material>
      </visual>
      <collision name="wall_east_collision">
        <geometry><box><size>0.1 11 0.3</size></box></geometry>
      </collision>
    </link>

    <link name="wall_west_link">
      <pose>-5.55 0 0.15 0 0 0</pose>
      <visual name="wall_west_visual">
        <geometry><box><size>0.1 11 0.3</size></box></geometry>
        <material>
          <ambient>0.25 0.25 0.25 1</ambient>
          <diffuse>0.25 0.25 0.25 1</diffuse>
        </material>
      </visual>
      <collision name="wall_west_collision">
        <geometry><box><size>0.1 11 0.3</size></box></geometry>
      </collision>
    </link>

  </model>



  <!--Z字折线内墙A 缺口朝东 逼机器人右行-->
  <model name="maze_wall_a">
    <static>true</static>
    <pose>-1.25 1.5 0.15 0 0 0</pose>
    <link name="wall_a_link">
      <visual name="wall_a_visual">
        <geometry><box><size>8.5 0.1 0.3</size></box></geometry>
        <material>
          <ambient>0.25 0.25 0.3 1</ambient>
          <diffuse>0.25 0.25 0.3 1</diffuse>
        </material>
      </visual>
      <collision name="wall_a_collision">
        <geometry><box><size>8.5 0.1 0.3</size></box></geometry>
      </collision>
    </link>
  </model>

  <!--Z字折线内墙B 缺口朝西 逼机器人左行-->
  <model name="maze_wall_b">
    <static>true</static>
    <pose>1.25 -1.5 0.15 0 0 0</pose>
    <link name="wall_b_link">
      <visual name="wall_b_visual">
        <geometry><box><size>8.5 0.1 0.3</size></box></geometry>
        <material>
          <ambient>0.25 0.25 0.3 1</ambient>
          <diffuse>0.25 0.25 0.3 1</diffuse>
        </material>
      </visual>
      <collision name="wall_b_collision">
        <geometry><box><size>8.5 0.1 0.3</size></box></geometry>
      </collision>
    </link>
  </model>








</world>

</sdf>
