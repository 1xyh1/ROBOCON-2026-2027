Panels:
- Class: rviz_common/Displays
  Name: Displays
- Class: rviz_common/Views
  Name: Views
- Class: rviz_common/Time
  Name: Time
  SyncMode: 0
  SyncSource: FAST-LIO cloud
Visualization Manager:
  Class: ''
  Enabled: true
  Global Options:
    Background Color: 35; 39; 47
    Fixed Frame: odom
    Frame Rate: 20
  Displays:
  - Class: rviz_default_plugins/Grid
    Name: Grid - 1 m
    Enabled: true
    Value: true
    Cell Size: 1
    Plane Cell Count: 30
    Color: 90; 95; 105
  - Class: rviz_default_plugins/TF
    Name: TF - real published frames
    Enabled: true
    Value: true
    Frame Timeout: 10
    Frames:
      All Enabled: true
    Show Arrows: false
    Show Axes: true
    Show Names: true
    Marker Scale: 0.4
  - Class: rviz_default_plugins/PointCloud2
    Name: FAST-LIO cloud
    Enabled: true
    Value: true
    Alpha: 1
    Color Transformer: AxisColor
    Position Transformer: XYZ
    Axis: Z
    Autocompute Value Bounds:
      Value: true
    Use rainbow: true
    Decay Time: 4
    Style: Flat Squares
    Size (Pixels): 2
    Size (m): 0.025
    Use Fixed Frame: true
    Topic:
      Value: /cloud_registered
      Reliability Policy: Best Effort
      Durability Policy: Volatile
      History Policy: Keep Last
      Depth: 5
      Filter size: 10
  - Class: rviz_default_plugins/Path
    Name: FAST-LIO path
    Enabled: true
    Value: true
    Alpha: 1
    Color: 70; 220; 150
    Buffer Length: 1
    Line Style: Billboards
    Line Width: 0.025
    Pose Style: None
    Topic:
      Value: /path
      Reliability Policy: Best Effort
      Durability Policy: Volatile
      History Policy: Keep Last
      Depth: 5
      Filter size: 10
  - Class: rviz_default_plugins/Odometry
    Name: MID-360 IMU pose - not chassis origin
    Enabled: true
    Value: true
    Keep: 100
    Position Tolerance: 0.02
    Angle Tolerance: 0.05
    Covariance:
      Value: false
    Shape:
      Value: Axes
      Axes Length: 0.25
      Axes Radius: 0.015
    Topic:
      Value: /Odometry
      Reliability Policy: Best Effort
      Durability Policy: Volatile
      History Policy: Keep Last
      Depth: 5
      Filter size: 10
  Tools:
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Select
  - Class: rviz_default_plugins/FocusCamera
  - Class: rviz_default_plugins/Measure
    Line color: 255; 220; 80
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Target Frame: <Fixed Frame>
      Distance: 12
      Pitch: 0.65
      Yaw: 0.8
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Near Clip Distance: 0.01
  Value: true
Window Geometry:
  Width: 1440
  Height: 900
  Hide Left Dock: false
  Hide Right Dock: false
  QMainWindow State: 
  Displays:
    collapsed: false
  Views:
    collapsed: false
  Time:
    collapsed: false
