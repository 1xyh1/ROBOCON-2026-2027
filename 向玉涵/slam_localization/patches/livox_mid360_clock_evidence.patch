+uint64_t UtcOffsetNs() {
+  static const uint64_t offset = []() -> uint64_t {
+    const char* value = std::getenv("ROBOCON_LIVOX_PTP_TAI_UTC_OFFSET_S");
+    if (!value) return 0;
+    const auto seconds = std::strtoull(value, nullptr, 10);
+    return seconds <= 100 ? seconds * 1000000000ULL : 0;
+  }();
+  return offset;
+}
+bool RequirePtp() {
+  static const bool required = []() {
+    const char* value = std::getenv("ROBOCON_LIVOX_REQUIRE_PTP");
+    return value && std::strcmp(value, "1") == 0;
+  }();
+  return required;
+}
+}  // namespace
+
+void PubHandler::UpdateDeviceClock(bool valid, uint64_t last_sync, uint32_t powerup) {
+  std::lock_guard<std::mutex> lock(clock_mutex_);
+  if (valid && device_seen_ && powerup != device_powerup_) {
+    ++epoch_;
+    fusion_reset_required_ = true;
+  }
+  if (valid) {
+    device_powerup_ = powerup;
+    device_seen_ = true;
+  }
+  device_valid_ = valid;
+  device_last_sync_ = last_sync;
+  device_received_ = std::chrono::steady_clock::now();
+}
+
+bool PubHandler::DeviceClockReadyLocked() {
+  const auto utc_now = std::chrono::duration_cast<std::chrono::nanoseconds>(
+      std::chrono::system_clock::now().time_since_epoch()).count();
+  const double sync_age = (static_cast<double>(utc_now) - device_last_sync_ + UtcOffsetNs()) * 1e-9;
+  const double query_age = std::chrono::duration<double>(
+      std::chrono::steady_clock::now() - device_received_).count();
+  const bool ready = device_valid_ && device_last_sync_ &&
+      query_age <= 2.5 && sync_age >= -0.05 && sync_age <= 3.0;
+  if (RequirePtp() && fusion_started_ && !ready && !fusion_reset_required_) {
+    ++epoch_;
+    fusion_reset_required_ = true;
+  }
+  return ready;
+}
+
+bool PubHandler::ObserveClock(LivoxLidarEthernetPacket* packet) {
+  std::lock_guard<std::mutex> lock(clock_mutex_);
+  auto& stream = packet->data_type == kLivoxLidarImuData ? imu_clock_ : lidar_clock_;
+  uint64_t stamp = 0;
+  std::memcpy(&stamp, packet->timestamp, sizeof(stamp));
+  const auto now = std::chrono::steady_clock::now();
+  if (stream.packets && stream.time_type == kTimestampTypeGptpOrPtp) {
+    const double stamp_delta = (static_cast<double>(stamp) - stream.stamp) * 1e-9;
+    const double receive_delta = std::chrono::duration<double>(now - stream.received).count();
+    if (packet->time_type != stream.time_type || stamp < stream.stamp ||
+        std::abs(stamp_delta - receive_delta) > 0.5) {
+      ++epoch_;
+      // Never silently stitch two clock epochs into one FAST-LIO trajectory.
+      // Restart the whole front end after re-synchronizing/relocalizing.
+      fusion_reset_required_ = true;
+    }
+  }
+  stream.time_type = packet->time_type;
+  stream.stamp = stamp;
+  stream.received = now;
+  ++stream.packets;
+  if (RequirePtp() && packet->time_type == kTimestampTypeGptpOrPtp) {
+    const auto utc_now = std::chrono::duration_cast<std::chrono::nanoseconds>(
+        std::chrono::system_clock::now().time_since_epoch()).count();
+    const double age = (static_cast<double>(utc_now) - stamp + UtcOffsetNs()) * 1e-9;
+    if (age < -0.02 || age > 0.2) {
+      if (fusion_started_ && !fusion_reset_required_) ++epoch_;
+      if (fusion_started_) fusion_reset_required_ = true;
+      ++rejected_packets_;
+      return false;
+    }
+  }
+  if (RequirePtp() && (!DeviceClockReadyLocked() ||
+      packet->time_type != kTimestampTypeGptpOrPtp || fusion_reset_required_)) {
+    ++rejected_packets_;
+    return false;
+  }
+  fusion_started_ = true;
+  return true;
+}
+
+std::string PubHandler::ClockStatusJson() {
+  std::lock_guard<std::mutex> lock(clock_mutex_);
+  const auto now = std::chrono::steady_clock::now();
+  std::ostringstream json;
+  const bool device_ready = DeviceClockReadyLocked();
+  json << "{\"session\":" << session_ << ",\"epoch\":" << epoch_
+       << ",\"utc_offset_s\":" << UtcOffsetNs() / 1000000000ULL
+       << ",\"require_ptp\":" << (RequirePtp() ? "true" : "false")
+       << ",\"device_clock_gate\":" << (device_ready ? "true" : "false")
+       << ",\"fusion_reset_required\":" << (fusion_reset_required_ ? "true" : "false")
+       << ",\"rejected_packets\":" << rejected_packets_;
+  auto append = [&](const char* name, const StreamClock& stream) {
+    const double age = stream.packets ? std::chrono::duration<double>(now - stream.received).count() : -1;
+    json << ",\"" << name << "\":{\"time_type\":" << static_cast<int>(stream.time_type)
+         << ",\"raw_stamp_ns\":" << stream.stamp << ",\"packets\":" << stream.packets
+         << ",\"receive_age_s\":" << age << "}";
+  };
+  append("lidar", lidar_clock_);
+  append("imu", imu_clock_);
+  json << "}";
+  return json.str();
+}
